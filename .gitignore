# =============================================================================
article/*.pdf
article/*.aux
article/*.bbl
article/*.blg
article/*.log
article/*.out
article/*.toc
article/*.lot
article/*.lof
article/*.fls
article/*.fdb_latexmk
article/*.synctex.gz
article/*.spl
article/*.bak*
article/*.backup

# Algorithm package generated files
article/algorithm.sty
article/algorithmic.sty
article/algorithms.log

# Proof document artifacts
article/proof.aux
article/proof.log
article/proof.pdf
article/proof.spl
article/proof.fdb_latexmk
article/proof.fls
article/proof.synctex.gz
article/proof.bak*

# =============================================================================
